#!/bin/sh

# Easy VLESS 1.0: a saved configuration is applied by Easy VLESS itself
# (Save & Apply, Save & Start: sing-box check first, then the restart with a
# result). Up to 0.9 a ucitrack entry also restarted the service in the
# background after every "uci commit" of LuCI - also after a plain Save,
# without the check and without a result. Drop what older versions added:
# the entry of the old /etc/config/ucitrack and the trigger the ucitrack
# service still holds (its file /usr/share/ucitrack/easy-vless.json is no
# longer part of the package).
if [ -e "/etc/config/ucitrack" ]; then
	while uci -q get ucitrack.@easy_vless[-1] >/dev/null; do
		uci -q delete ucitrack.@easy_vless[-1]
	done
	uci -q commit ucitrack
fi
[ -x /etc/init.d/ucitrack ] && ubus -t 2 list service >/dev/null 2>&1 && /etc/init.d/ucitrack restart >/dev/null 2>&1

uci -q batch <<-EOF
	delete firewall.easy_vless
	set firewall.easy_vless=include
	set firewall.easy_vless.type='script'
	set firewall.easy_vless.path='/var/etc/easy_vless.include'

	set dhcp.@dnsmasq[0].localuse=1
	commit dhcp

	set uhttpd.main.max_requests=50
	commit uhttpd
EOF

uci -q set firewall.easy_vless.reload='1'
uci commit firewall

[ ! -s "/etc/config/easy_vless" ] && cp -f /usr/share/easy_vless/0_default_config /etc/config/easy_vless

# Upgrade path for configs created by older Easy VLESS versions: add the
# options/sections the current runtime and LuCI expect, never touch existing
# values.
uci -q get easy_vless.@global[0].routing_mode >/dev/null || uci -q set easy_vless.@global[0].routing_mode='singbox'
uci -q get easy_vless.@global[0].clash_api_port >/dev/null || uci -q set easy_vless.@global[0].clash_api_port='9095'
if ! uci -q get easy_vless.main_router >/dev/null; then
	uci -q set easy_vless.main_router=nodes
	uci -q set easy_vless.main_router.remarks='Main Router'
	uci -q set easy_vless.main_router.type='sing-box'
	uci -q set easy_vless.main_router.protocol='_shunt'
	uci -q set easy_vless.main_router.default_node='_direct'
fi
uci -q commit easy_vless

chmod +x /usr/share/easy_vless/*.sh

rm -f /tmp/luci-indexcache /tmp/luci-indexcache.*
rm -rf /tmp/luci-modulecache/
killall -HUP rpcd 2>/dev/null

exit 0
