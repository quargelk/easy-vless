#!/bin/sh /etc/rc.common

START=99
STOP=15

. $IPKG_INSTROOT/usr/share/easy_vless/utils.sh
APP_FILE=${APP_PATH}/app.sh
APPLIED_CONFIG=/var/run/${CONFIG}.applied
CONFIG_FILE=/etc/config/${CONFIG}
umask 077
LOCK_FILE_DIR=/var/lock
LOCK_FILE=${LOCK_FILE_DIR}/${CONFIG}.lock

set_lock() {
	mkdir -p "$LOCK_FILE_DIR"
	exec 9>>"${LOCK_FILE}.flock"
	flock -xn 9 || return 1
	touch "$LOCK_FILE"
}

unset_lock() {
	rm -f "$LOCK_FILE"
	flock -u 9
	exec 9>&-
}

boot_func() {
	local delay=$(uci -q get ${CONFIG}.@global_delay[0].start_delay || echo 1)
	if [ "$delay" -gt 0 ]; then
		log_i18n 0 "Start after a delay of %s seconds!" "${delay}"
		sleep $delay
	fi
	restart boot
	touch ${LOCK_FILE_DIR}/${CONFIG}_ready.lock
}

boot() {
	boot_func >/dev/null 2>&1 &
}

start() {
	set_lock || return 1
	local rc=0
	"$APP_FILE" start && save_applied_config || rc=$?
	unset_lock
	return "$rc"
}

stop() {
	mkdir -p "$LOCK_FILE_DIR"
	exec 9>>"${LOCK_FILE}.flock"
	local waited=0 rc=0
	until flock -xn 9; do
		[ "$waited" -lt "$EV_OP_LOCK_WAIT" ] || return 1
		waited=$((waited + 1))
		sleep 1
	done
	touch "$LOCK_FILE"
	"$APP_FILE" stop || rc=$?
	unset_lock
	return "$rc"
}

save_applied_config() {
	mkdir -p "$(dirname "$APPLIED_CONFIG")" &&
		cat "$CONFIG_FILE" > "${APPLIED_CONFIG}.tmp" &&
		mv -f "${APPLIED_CONFIG}.tmp" "$APPLIED_CONFIG"
}

config_sum() {
	md5sum /etc/config/${CONFIG} 2>/dev/null | cut -d ' ' -f 1
}

# The subscription lock holds the PID of its owner (subscribe.lua); a lock
# left behind by a process that is gone is not waited for.
sub_lock_held() {
	local pid
	[ -f "$1" ] || return 1
	pid=$(cat "$1" 2>/dev/null)
	case "$pid" in
		""|*[!0-9]*) return 0 ;;
	esac
	[ -d "/proc/$pid" ]
}

restart() {
	local again=${LOCK_FILE_DIR}/${CONFIG}_restart_again mode=$1 sum node rc=0 previous_pid
	if ! set_lock; then
		# A restart is running already. It may have read the configuration
		# before the change this request is about, so the request is not
		# simply dropped (1.0): the running restart finds this note when it
		# has finished and runs once more if the configuration is not the one
		# it started with.
		touch "$again"
		log_i18n 0 "The script is already running, do not run it again. Exit."
		exit 0
	fi
	rule_lock=${LOCK_FILE_DIR}/${CONFIG}_rule_update.lock
	sub_lock=${LOCK_FILE_DIR}/${CONFIG}_subscribe.lock
	for i in $(seq 1 300); do
		if [ ! -f "$rule_lock" ] && ! sub_lock_held "$sub_lock"; then
			break
		fi
		sleep 2
	done
	rm -f "$rule_lock" "$sub_lock"
	while :; do
		rm -f "$again"
		sum=$(config_sum)
		node=$(config_n_get @global[0] node)
		if [ "$(config_n_get @global[0] enabled 0)" = 1 ] &&
			[ "$(config_n_get "$node" type)" = sing-box ] &&
			! "$APP_FILE" check "$node" >/dev/null; then
			log 0 "Easy VLESS: configuration check failed before restart."
			rc=1
			break
		fi
		previous_pid=$(cat "$EV_PID_FILE" 2>/dev/null)
		core_owns_config "$previous_pid" "$(get_cache_var easy_vless_main_config)" || previous_pid=""
		if ! "$APP_FILE" stop; then
			rc=1
			break
		fi
		if ! "$APP_FILE" start "$mode"; then
			# Preserve the failed candidate for inspection and only roll
			# back if no one saved another configuration in the meantime.
			if [ -n "$previous_pid" ] && [ -s "$APPLIED_CONFIG" ] &&
				[ "$(config_sum)" = "$sum" ] &&
				cat "$CONFIG_FILE" > "${APPLIED_CONFIG}.rejected" &&
				cat "$APPLIED_CONFIG" > "${CONFIG_FILE}.easy-vless-restore" &&
				mv -f "${CONFIG_FILE}.easy-vless-restore" "$CONFIG_FILE"; then
				if "$APP_FILE" start; then
					printf '%s\n' apply_rolled_back > "$EV_STATE_ERROR"
				else
					printf '%s\n' rollback_failed > "$EV_STATE_ERROR"
				fi
			fi
			rc=1
			break
		fi
		[ "$(config_sum)" != "$sum" ] || save_applied_config || rc=1
		[ -f "$again" ] && [ "$(config_sum)" != "$sum" ] || break
		# "boot" (subscriptions updated on boot) belongs to the first run only
		mode=""
	done
	rm -f "$again"
	unset_lock
	return "$rc"
}

reload() {
	echo "Warning: This service does not support configuration reloading"
	echo "Performing full restart instead..."
	restart
}
