#!/bin/sh /etc/rc.common

START=99
STOP=15

. $IPKG_INSTROOT/usr/share/easy_vless/utils.sh
APP_FILE=${APP_PATH}/app.sh
LOCK_FILE_DIR=/var/lock
LOCK_FILE=${LOCK_FILE_DIR}/${CONFIG}.lock

set_lock() {
	[ ! -d "$LOCK_FILE_DIR" ] && mkdir -p $LOCK_FILE_DIR
	exec 999>"$LOCK_FILE"
	flock -xn 999
}

unset_lock() {
	flock -u 999
	rm -rf "$LOCK_FILE"
}

unlock() {
	failcount=1
	while [ "$failcount" -le 10 ]; do
		if [ -f "$LOCK_FILE" ]; then
			let "failcount++"
			sleep 1s
			[ "$failcount" -ge 10 ] && unset_lock
		else
			break
		fi
	done
}

boot_func() {
	local delay=$(uci -q get ${CONFIG}.@global_delay[0].start_delay || echo 1)
	if [ "$delay" -gt 0 ]; then
		log_i18n 0 "Start after a delay of %s seconds!" "${delay}"
		sleep $delay
	fi
	restart boot
	touch ${LOCK_FILE_DIR}/${CONFIG}_ready.lock
}

boot() {
	boot_func >/dev/null 2>&1 &
}

start() {
	set_lock
	[ $? == 1 ] && log_i18n 0 "The script is already running, do not run it again. Exit." && exit 0
	$APP_FILE start
	unset_lock
}

stop() {
	unlock
	set_lock
	[ $? == 1 ] && log_i18n 0 "Stop the script and wait for a timeout, then exit without repeating the process." && exit 0
	$APP_FILE stop
	unset_lock
}

config_sum() {
	md5sum /etc/config/${CONFIG} 2>/dev/null | cut -d ' ' -f 1
}

# The subscription lock holds the PID of its owner (subscribe.lua); a lock
# left behind by a process that is gone is not waited for.
sub_lock_held() {
	local pid
	[ -f "$1" ] || return 1
	pid=$(cat "$1" 2>/dev/null)
	case "$pid" in
		""|*[!0-9]*) return 0 ;;
	esac
	[ -d "/proc/$pid" ]
}

restart() {
	local again=${LOCK_FILE_DIR}/${CONFIG}_restart_again mode=$1 sum
	set_lock
	if [ $? == 1 ]; then
		# A restart is running already. It may have read the configuration
		# before the change this request is about, so the request is not
		# simply dropped (1.0): the running restart finds this note when it
		# has finished and runs once more if the configuration is not the one
		# it started with.
		touch "$again"
		log_i18n 0 "The script is already running, do not run it again. Exit."
		exit 0
	fi
	rule_lock=${LOCK_FILE_DIR}/${CONFIG}_rule_update.lock
	sub_lock=${LOCK_FILE_DIR}/${CONFIG}_subscribe.lock
	for i in $(seq 1 300); do
		if [ ! -f "$rule_lock" ] && ! sub_lock_held "$sub_lock"; then
			break
		fi
		sleep 2
	done
	rm -f "$rule_lock" "$sub_lock"
	while :; do
		rm -f "$again"
		sum=$(config_sum)
		$APP_FILE stop
		$APP_FILE start $mode
		[ -f "$again" ] && [ "$(config_sum)" != "$sum" ] || break
		# "boot" (subscriptions updated on boot) belongs to the first run only
		mode=""
	done
	rm -f "$again"
	unset_lock
}

reload() {
	echo "Warning: This service does not support configuration reloading"
	echo "Performing full restart instead..."
	restart
}
