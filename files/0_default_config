
config global 'global'
	option enabled '0'
	option node 'node_example'
	option client_proxy '1'
	option localhost_proxy '1'
	option loglevel 'info'
	option direct_dns_protocol 'udp'
	option direct_dns '223.5.5.5'
	option direct_dns_query_strategy 'UseIPv4'
	option remote_dns_protocol 'udp'
	option remote_dns '1.1.1.1'
	option remote_fakedns '1'
	option dns_redirect '1'
	option pid_file '/var/run/easy_vless.pid'

config global_forwarding 'global_forwarding'
	option prefer_nft '1'
	option tcp_proxy_way 'tproxy'
	option tcp_redir_ports '1:65535'
	option udp_redir_ports '1:65535'
	option ipv6_tproxy '0'
	option accept_icmp '0'

config global_delay 'global_delay'
	option start_delay '1'

config nodes 'node_example'
	option remarks 'Test VLESS'
	option type 'sing-box'
	option protocol 'vless'
	option address '1.2.3.4'
	option port '443'
	option uuid 'REPLACE-ME'
	option tls '1'
	option reality '1'
	option reality_publicKey 'REPLACE-ME'
	option reality_shortId 'REPLACE-ME'
	option utls '1'
	option fingerprint 'chrome'
	option tls_serverName 'www.example.com'
	option transport 'tcp'
	option flow 'xtls-rprx-vision'
