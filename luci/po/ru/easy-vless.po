msgid "Running (PID %s)"
msgstr "Работает (PID %s)"

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "The main switch is on, but sing-box is not running. See the log on Main; Save & Apply starts it again."
msgstr "Главный переключатель включён, но sing-box не работает. Смотрите журнал на «Главной»; «Применить» запустит его снова."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "The main switch is off."
msgstr "Главный переключатель выключен."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
