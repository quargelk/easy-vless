#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Easy VLESS is stopped; nothing is loaded."
msgstr "Easy VLESS остановлен; ничего не загружено."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Easy VLESS is stopped, but its nft table is still loaded (left over from a previous run). Press Stop on Main to remove it."
msgstr "Easy VLESS остановлен, но его таблица nft всё ещё загружена (осталась от прошлого запуска). Нажмите «Остановить» на «Главной», чтобы её убрать."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Easy VLESS is stopped, but its ip rule / routing table 998 is still there. Press Stop on Main to remove it."
msgstr "Easy VLESS остановлен, но его ip rule / таблица маршрутов 998 всё ещё на месте. Нажмите «Остановить» на «Главной», чтобы их убрать."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "sing-box is running, but the nft table inet easy_vless does not exist: no traffic is redirected. Restart Easy VLESS (Save & Apply on Main)."
msgstr "sing-box работает, но таблицы nft inet easy_vless нет: трафик не перенаправляется. Перезапустите Easy VLESS («Применить» на «Главной»)."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Loaded."
msgstr "Загружена."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Missing chain(s): %s. Restart Easy VLESS; if it stays, see the log on Main."
msgstr "Нет цепочек: %s. Перезапустите Easy VLESS; если не поможет, смотрите журнал на «Главной»."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "All %d chains are present."
msgstr "Все цепочки на месте (%d)."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Missing set(s): %s. Restart Easy VLESS."
msgstr "Нет наборов: %s. Перезапустите Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "The set of direct (local) addresses is empty: connections to LAN addresses would be sent to the proxy. Restart Easy VLESS."
msgstr "Набор прямых (локальных) адресов пуст: соединения с адресами LAN ушли бы в прокси. Перезапустите Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Present (direct addresses: %d, server addresses: %d)."
msgstr "На месте (прямых адресов: %d, адресов серверов: %d)."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Packets marked %s are delivered to sing-box (ip rule → table %s)."
msgstr "Пакеты с меткой %s доставляются в sing-box (ip rule → таблица %s)."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "The ip rule for fwmark %s (table %s) is missing: redirected packets never reach sing-box. Restart Easy VLESS."
msgstr "Нет ip rule для fwmark %s (таблица %s): перенаправленные пакеты не доходят до sing-box. Перезапустите Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Routing table %s has no local route: redirected packets never reach sing-box. Restart Easy VLESS."
msgstr "В таблице маршрутов %s нет локального маршрута: перенаправленные пакеты не доходят до sing-box. Перезапустите Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "%s forwarding is switched off (redirected ports: disabled, Settings → Forwarding)."
msgstr "Перенаправление %s выключено (перенаправляемые порты: отключено, «Настройки» → «Перенаправление»)."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Client Proxy and Localhost Proxy are off: %s is not redirected."
msgstr "«Проксировать устройства LAN» и «Проксировать сам роутер» выключены: %s не перенаправляется."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "No %s rule for %s in the chain %s: %s traffic is not redirected. Restart Easy VLESS."
msgstr "Нет правила %s для %s в цепочке %s: трафик %s не перенаправляется. Перезапустите Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "The %s rule redirects to port %s, but sing-box listens on %s. Restart Easy VLESS."
msgstr "Правило %s перенаправляет на порт %s, а sing-box слушает %s. Перезапустите Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "%s to sing-box port %s."
msgstr "%s на порт sing-box %s."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Only ports %s."
msgstr "Только порты %s."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Traffic of LAN devices is handed to Easy VLESS."
msgstr "Трафик устройств LAN передаётся в Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Client Proxy is off (Main): LAN devices bypass Easy VLESS."
msgstr "«Проксировать устройства LAN» выключено («Главная»): устройства LAN идут мимо Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "The forwarding chain is not hooked into %s: traffic of LAN devices is not redirected. Restart Easy VLESS."
msgstr "Цепочка перенаправления не подключена к %s: трафик устройств LAN не перенаправляется. Перезапустите Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Traffic of the router itself is handed to Easy VLESS."
msgstr "Трафик самого роутера передаётся в Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Localhost Proxy is off (Main): the router's own traffic bypasses Easy VLESS."
msgstr "«Проксировать сам роутер» выключено («Главная»): трафик самого роутера идёт мимо Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "The output chain is not hooked into %s: the router's own traffic is not redirected. Restart Easy VLESS."
msgstr "Выходная цепочка не подключена к %s: трафик самого роутера не перенаправляется. Перезапустите Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Off (Settings → Forwarding): IPv6 connections bypass Easy VLESS."
msgstr "Выключен («Настройки» → «Перенаправление»): соединения IPv6 идут мимо Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "IPv6 traffic is redirected."
msgstr "Трафик IPv6 перенаправляется."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "IPv6 TProxy is on, but %s is missing: IPv6 traffic is not redirected. Restart Easy VLESS."
msgstr "IPv6 TProxy включён, но нет %s: трафик IPv6 не перенаправляется. Перезапустите Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Never proxied: %s."
msgstr "Никогда не проксируются: %s."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Only these ports are redirected, everything else goes directly: %s."
msgstr "Перенаправляются только эти порты, всё остальное идёт напрямую: %s."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "DNS queries (port 53) are redirected to the DNS of Easy VLESS."
msgstr "DNS-запросы (порт 53) перенаправляются на DNS Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "DNS redirect is on, but its rule is missing: devices that use their own DNS server bypass the DNS of Easy VLESS. Restart Easy VLESS."
msgstr "Перенаправление DNS включено, но его правила нет: устройства со своим DNS-сервером идут мимо DNS Easy VLESS. Перезапустите Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Off (Settings → DNS): only queries sent to the router itself are handled."
msgstr "Выключено («Настройки» → «DNS»): обрабатываются только запросы, отправленные самому роутеру."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Easy VLESS is stopped: names are resolved by the router's normal DNS."
msgstr "Easy VLESS остановлен: имена разрешает обычный DNS роутера."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Resolved by the router's DNS: %s"
msgstr "Разрешено DNS роутера: %s"

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Resolved: %s"
msgstr "Разрешено: %s"

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Resolved to a FakeDNS placeholder: %s"
msgstr "Разрешено в подставной адрес FakeDNS: %s"

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Answered empty: a DNS rule blocks this name."
msgstr "Ответ пустой: это имя блокирует правило DNS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Not resolved: %s."
msgstr "Не разрешено: %s."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "This name is resolved by Remote DNS through the proxy: check the server (Server Test) and Remote DNS (Settings → DNS)."
msgstr "Это имя разрешает удалённый DNS через прокси: проверьте сервер («Проверка сервера») и удалённый DNS («Настройки» → «DNS»)."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "This name is resolved by Direct DNS: check Direct DNS (Settings → DNS) and the WAN connection."
msgstr "Это имя разрешает прямой DNS: проверьте прямой DNS («Настройки» → «DNS») и подключение WAN."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "A DNS rule answers empty."
msgstr "Правило DNS отвечает пустым ответом."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "not certain: a DNS rule with geodata could apply first."
msgstr "не наверняка: раньше может сработать правило DNS с геоданными."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Not known: the DNS rule for this name uses a DNS server that is not part of the running configuration (%s). Restart Easy VLESS; if it stays, see the log on Main."
msgstr "Неизвестно: правило DNS для этого имени использует DNS-сервер, которого нет в работающей конфигурации (%s). Перезапустите Easy VLESS; если не поможет, смотрите журнал на «Главной»."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "The running configuration could not be read; which DNS server is used is not known."
msgstr "Не удалось прочитать работающую конфигурацию; какой DNS-сервер используется, неизвестно."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "In use for this name, as configured."
msgstr "Используется для этого имени, как и настроено."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Off (Settings → DNS)."
msgstr "Выключен («Настройки» → «DNS»)."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "On, but not used for this name (its rule resolves real addresses)."
msgstr "Включён, но для этого имени не используется (его правило получает настоящие адреса)."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Conflict: the answer is a FakeDNS placeholder (%s), but the rule for this name uses a real DNS server. An old answer may be cached: restart Easy VLESS, and flush the DNS cache of the device."
msgstr "Конфликт: ответ — подставной адрес FakeDNS (%s), а правило для этого имени использует настоящий DNS-сервер. Возможно, в кэше старый ответ: перезапустите Easy VLESS и очистите кэш DNS на устройстве."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Conflict: FakeDNS should answer this name, but a real address came back (%s). Another DNS answers before Easy VLESS, or an old answer is cached."
msgstr "Конфликт: на это имя должен отвечать FakeDNS, но пришёл настоящий адрес (%s). Раньше Easy VLESS отвечает другой DNS, или в кэше старый ответ."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "IPv4 only: IPv6 (AAAA) answers are suppressed, as configured."
msgstr "Только IPv4: ответы IPv6 (AAAA) подавляются, как и настроено."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Mismatch: IPv4 only is configured, but an IPv6 address was answered (%s). Another DNS answers before Easy VLESS."
msgstr "Несоответствие: настроено «только IPv4», а в ответе адрес IPv6 (%s). Раньше Easy VLESS отвечает другой DNS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Mismatch: this proxied name gets IPv6 addresses (%s), but IPv6 TProxy is off - IPv6 connections bypass the proxy. Set Remote DNS to IPv4 only or turn IPv6 TProxy on."
msgstr "Несоответствие: это проксируемое имя получает адреса IPv6 (%s), а IPv6 TProxy выключен — соединения IPv6 идут мимо прокси. Переключите удалённый DNS на «только IPv4» или включите IPv6 TProxy."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "IPv4 and IPv6 addresses are answered."
msgstr "В ответах есть адреса IPv4 и IPv6."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "The name has no IPv6 address."
msgstr "У имени нет адреса IPv6."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "%s answered"
msgstr "%s ответил"

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "through %s"
msgstr "через %s"

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "%s did not answer: %s."
msgstr "%s не ответил: %s."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "It is reached through the proxy (%s): run Server Test for that server, or choose another Remote DNS."
msgstr "Он доступен через прокси (%s): запустите «Проверку сервера» для этого сервера или выберите другой удалённый DNS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Check the WAN connection or set another Direct DNS (Settings → DNS)."
msgstr "Проверьте подключение WAN или задайте другой прямой DNS («Настройки» → «DNS»)."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Not checked: this name is not resolved by Remote DNS."
msgstr "Не проверялся: это имя удалённый DNS не разрешает."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Not checked: the DNS port of sing-box was not found."
msgstr "Не проверялся: DNS-порт sing-box не найден."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Port 53 of every LAN device is redirected to Easy VLESS, also when the device uses its own DNS server."
msgstr "Порт 53 каждого устройства LAN перенаправляется в Easy VLESS, даже если устройство использует свой DNS-сервер."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "DNS redirect is on, but its firewall rule is missing: a device with its own DNS server (for example 8.8.8.8) bypasses Easy VLESS. Restart Easy VLESS."
msgstr "Перенаправление DNS включено, но правила в межсетевом экране нет: устройство со своим DNS-сервером (например, 8.8.8.8) идёт мимо Easy VLESS. Перезапустите Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "DNS redirect is off: only devices that use the router as DNS are covered. A device with its own DNS server bypasses Easy VLESS (turn on DNS redirect in Settings → DNS)."
msgstr "Перенаправление DNS выключено: охвачены только устройства, у которых DNS — роутер. Устройство со своим DNS-сервером идёт мимо Easy VLESS (включите перенаправление DNS: «Настройки» → «DNS»)."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "DNS is not handed to Easy VLESS: DNS redirect is off and dnsmasq does not forward to sing-box. Turn on DNS redirect (Settings → DNS) and restart."
msgstr "DNS не передаётся в Easy VLESS: перенаправление DNS выключено, а dnsmasq не пересылает запросы в sing-box. Включите перенаправление DNS («Настройки» → «DNS») и перезапустите."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "The router cannot see whether a device uses encrypted DNS (DoH / DoT, \"Private DNS\", browser \"Secure DNS\"). Such a device resolves names itself; domain rules then work only through sniffing. Turn it off on the device if rules do not apply."
msgstr "Роутер не видит, использует ли устройство шифрованный DNS (DoH / DoT, «Частный DNS», «Безопасный DNS» в браузере). Такое устройство разрешает имена само; правила по доменам тогда работают только через распознавание трафика. Если правила не срабатывают, отключите его на устройстве."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Sent to Remote DNS: %s"
msgstr "Передаётся удалённому DNS: %s"

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "Could not be checked: %s"
msgstr "Проверить не удалось: %s"

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "sing-box %s"
msgstr "sing-box %s"

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "The sing-box binary was not found. Install a sing-box package (easy-vless-sing-box depends on it)."
msgstr "Исполняемый файл sing-box не найден. Установите пакет sing-box (от него зависит easy-vless-sing-box)."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "The sing-box backend of Easy VLESS is not installed (package easy-vless-sing-box)."
msgstr "Не установлен бэкенд sing-box для Easy VLESS (пакет easy-vless-sing-box)."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
msgid "fw4, dnsmasq with nftset support and the kernel modules are present."
msgstr "fw4, dnsmasq с поддержкой nftset и модули ядра на месте."

#: luci/htdocs/luci-static/resources/view/easy_vless/diagnostics.js
