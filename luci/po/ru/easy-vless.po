msgid "Expecting ports (1-65535) or ranges from:to separated by commas"
msgstr "Ожидаются порты (1-65535) или диапазоны от:до через запятую"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "DNS"
msgstr "DNS"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "While Easy VLESS runs, dnsmasq forwards DNS queries to sing-box: domains that go direct are resolved by the direct DNS, proxied domains by the remote DNS through the server. The defaults work for most setups."
msgstr "Пока Easy VLESS работает, dnsmasq передаёт DNS-запросы в sing-box: домены, которые идут напрямую, разрешает прямой DNS, а проксируемые домены — удалённый DNS через сервер. Значения по умолчанию подходят для большинства случаев."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Direct DNS"
msgstr "Прямой DNS"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "DNS for domains that go direct. Auto uses the DNS servers of your internet provider."
msgstr "DNS для доменов, которые идут напрямую. «Авто» использует DNS-серверы вашего интернет-провайдера."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Auto (ISP / dnsmasq upstream)"
msgstr "Авто (DNS провайдера / upstream dnsmasq)"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Direct DNS server"
msgstr "Сервер прямого DNS"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "IP or IP:port."
msgstr "IP или IP:порт."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Direct DNS: IP versions"
msgstr "Прямой DNS: версии IP"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "UseIP: IPv4 and IPv6 addresses, UseIPv4 / UseIPv6: only that version."
msgstr "UseIP: адреса IPv4 и IPv6, UseIPv4 / UseIPv6: только эта версия."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Remote DNS protocol"
msgstr "Протокол удалённого DNS"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "DNS for proxied domains, queried through the server."
msgstr "DNS для проксируемых доменов, запросы идут через сервер."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Remote DNS"
msgstr "Удалённый DNS"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Remote DNS (DoH URL)"
msgstr "Удалённый DNS (URL DoH)"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "URL, optionally followed by a bootstrap IP: <code>https://dns.google/dns-query,8.8.8.8</code>."
msgstr "URL, при необходимости с IP для начального запроса через запятую: <code>https://dns.google/dns-query,8.8.8.8</code>."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Expecting an https:// URL"
msgstr "Ожидается URL https://"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Remote DNS EDNS Client Subnet"
msgstr "EDNS Client Subnet для удалённого DNS"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Public IP sent to the DNS server as client location (RFC 7871). Empty = off."
msgstr "Публичный IP, который передаётся DNS-серверу как местоположение клиента (RFC 7871). Пусто = выключено."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Remote DNS route"
msgstr "Маршрут удалённого DNS"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "How the remote DNS server is reached."
msgstr "Как идут запросы к удалённому DNS-серверу."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Remote (through the proxy)"
msgstr "Удалённо (через прокси)"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "FakeDNS"
msgstr "FakeDNS"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Answer proxied domains with fake IPs (faster, the real resolution happens on the server)."
msgstr "Отвечать на проксируемые домены поддельными IP (быстрее, настоящее разрешение имени происходит на сервере)."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Remote DNS: IP versions"
msgstr "Удалённый DNS: версии IP"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "UseIPv4 (default): proxied domains get IPv4 addresses only."
msgstr "UseIPv4 (по умолчанию): проксируемые домены получают только адреса IPv4."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Static DNS entries"
msgstr "Статические DNS-записи"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "One per line: <code>domain IP</code>, e.g. <code>dns.google 8.8.8.8</code>."
msgstr "По одной в строке: <code>домен IP</code>, например <code>dns.google 8.8.8.8</code>."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "DNS Redirect"
msgstr "Перенаправление DNS"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Redirect DNS queries of proxied LAN devices to the router (dnsmasq), so their lookups follow the Easy VLESS DNS rules."
msgstr "Перенаправлять DNS-запросы проксируемых устройств LAN на роутер (dnsmasq), чтобы они подчинялись DNS-правилам Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Forwarding"
msgstr "Перенаправление"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Which connections of LAN devices and of the router are redirected into Easy VLESS (nftables transparent proxy). Ports: single ports and ranges <code>from:to</code>, comma separated, e.g. <code>21,80,443,1000:2000</code>."
msgstr "Какие подключения устройств LAN и самого роутера перенаправляются в Easy VLESS (прозрачный прокси nftables). Порты: отдельные порты и диапазоны <code>от:до</code> через запятую, например <code>21,80,443,1000:2000</code>."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "TCP ports never proxied"
msgstr "TCP-порты, которые никогда не проксируются"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Never proxied (highest priority). Empty = none."
msgstr "Никогда не проксируются (наивысший приоритет). Пусто = нет."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "UDP ports never proxied"
msgstr "UDP-порты, которые никогда не проксируются"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "TCP ports to redirect"
msgstr "TCP-порты для перенаправления"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Only connections to these ports enter Easy VLESS routing; other ports go direct."
msgstr "В маршрутизацию Easy VLESS попадают только подключения к этим портам; остальные порты идут напрямую."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "All"
msgstr "Все"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Common ports"
msgstr "Распространённые порты"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "UDP ports to redirect"
msgstr "UDP-порты для перенаправления"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "TCP redirect method"
msgstr "Способ перенаправления TCP"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "TPROXY (default) keeps the original destination for sing-box; REDIRECT is a fallback for special cases."
msgstr "TPROXY (по умолчанию) сохраняет исходный адрес назначения для sing-box; REDIRECT — запасной вариант для особых случаев."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "IPv6 TProxy"
msgstr "IPv6 TProxy"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Experimental. Make sure your server supports IPv6."
msgstr "Экспериментально. Убедитесь, что ваш сервер поддерживает IPv6."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Answer ping locally"
msgstr "Отвечать на ping локально"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Ping (ICMP) cannot go through VLESS: with this on, a ping to a proxied address is answered by the router itself."
msgstr "Ping (ICMP) не может идти через VLESS: если включено, на ping к проксируемому адресу отвечает сам роутер."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Advanced"
msgstr "Дополнительно"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "<b>singbox</b>: all redirected traffic enters sing-box, which applies the rules."
msgstr "<b>singbox</b>: весь перенаправленный трафик попадает в sing-box, который применяет правила."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Log level"
msgstr "Уровень журналирования"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "sing-box log"
msgstr "Журнал sing-box"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Write the sing-box log to /tmp/etc/easy_vless/."
msgstr "Записывать журнал sing-box в /tmp/etc/easy_vless/."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Clash API port"
msgstr "Порт Clash API"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Local port (127.0.0.1) of the sing-box Clash API used for URL Test results; a free port is picked if it is busy."
msgstr "Локальный порт (127.0.0.1) Clash API sing-box, через который читаются результаты URL-теста; если порт занят, выбирается свободный."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Node SOCKS port"
msgstr "SOCKS-порт узла"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Optional local SOCKS5 inbound of the main instance (rule inbound \"SOCKS\"). Empty = off."
msgstr "Необязательный локальный вход SOCKS5 основного экземпляра (входящее подключение «SOCKS» в правилах). Пусто = выключено."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "SOCKS bind local"
msgstr "SOCKS только локально"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Listen on 127.0.0.1 only."
msgstr "Слушать только на 127.0.0.1."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Start delay (s)"
msgstr "Задержка запуска (с)"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "Seconds to wait after boot before starting."
msgstr "Сколько секунд ждать после загрузки перед запуском."

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js luci/root/usr/share/luci/menu.d/luci-app-easy-vless.json
msgid "Settings"
msgstr "Настройки"

#: luci/htdocs/luci-static/resources/view/easy_vless/settings.js
msgid "DNS and forwarding of Easy VLESS. The defaults work for most setups. Changes apply with Save & Apply (the service restarts)."
msgstr "DNS и перенаправление трафика Easy VLESS. Значения по умолчанию подходят для большинства случаев. Изменения применяются кнопкой «Применить» (служба перезапускается)."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Welcome"
msgstr "Начало"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Routing"
msgstr "Маршрутизация"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Review"
msgstr "Обзор"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Done"
msgstr "Готово"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Paste the vless:// link of your server."
msgstr "Вставьте ссылку vless:// вашего сервера."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Paste exactly one link. More servers can be added later in Node List."
msgstr "Вставьте ровно одну ссылку. Другие серверы можно добавить позже в «Списке узлов»."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "This is not a link: a VLESS link starts with vless://"
msgstr "Это не ссылка: ссылка VLESS начинается с vless://"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "This looks like a subscription address, not a server link. Subscriptions are added in Node List → URL Subscriptions; here paste one vless:// link."
msgstr "Похоже на адрес подписки, а не на ссылку сервера. Подписки добавляются в «Списке узлов» → «Подписки по URL»; здесь вставьте одну ссылку vless://."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "\"%s://\" links are not supported: Easy VLESS works with VLESS servers only (vless://)."
msgstr "Ссылки вида «%s://» не поддерживаются: Easy VLESS работает только с серверами VLESS (vless://)."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The link is incomplete: expected vless://UUID@address:port?parameters#name"
msgstr "Ссылка неполная: ожидается vless://UUID@адрес:порт?параметры#имя"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The user ID in the link is not a UUID (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)."
msgstr "Идентификатор пользователя в ссылке — не UUID (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The port in the link must be between 1 and 65535."
msgstr "Порт в ссылке должен быть от 1 до 65535."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "not tested yet"
msgstr "ещё не проверялся"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "All traffic"
msgstr "Весь трафик"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "new rule"
msgstr "новое правило"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "was: %s"
msgstr "было: %s"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "unchanged"
msgstr "без изменений"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "unknown error"
msgstr "неизвестная ошибка"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Easy VLESS setup"
msgstr "Настройка Easy VLESS"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Step %d of %d"
msgstr "Шаг %d из %d"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Back"
msgstr "Назад"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Next"
msgstr "Далее"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Easy VLESS sends the traffic of this router and of your devices through a VLESS server (sing-box), while Russian sites stay direct."
msgstr "Easy VLESS пропускает трафик этого роутера и ваших устройств через VLESS-сервер (sing-box), а российские сайты открываются напрямую."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "This wizard sets it up in a few steps:"
msgstr "Мастер настроит всё за несколько шагов:"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "add your VLESS server (a vless:// link from your provider);"
msgstr "добавить ваш VLESS-сервер (ссылку vless:// от провайдера);"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "check that the server works;"
msgstr "проверить, что сервер работает;"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "choose what goes through the server;"
msgstr "выбрать, что пойдёт через сервер;"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "review and start Easy VLESS."
msgstr "проверить настройки и запустить Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "You need the vless:// link of your server. Nothing on the router changes before the last step."
msgstr "Понадобится ссылка vless:// вашего сервера. До последнего шага на роутере ничего не меняется."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Easy VLESS is already set up on this router. The wizard does not replace your settings: it adds a server, changes the routing only if you choose so in step 4, and Review lists every change before anything is applied."
msgstr "Easy VLESS на этом роутере уже настроен. Мастер не заменяет ваши настройки: он добавляет сервер, меняет маршрутизацию только если вы выберете это на шаге 4, а перед применением на шаге «Обзор» показывает все изменения."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The setup was completed before; you can run it again."
msgstr "Настройка уже была завершена; её можно пройти ещё раз."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "An earlier Apply of the wizard did not finish (the page was closed or the router restarted). The configuration saved before it can be restored."
msgstr "Предыдущее применение мастера не завершилось (страница была закрыта или роутер перезагрузился). Конфигурацию, сохранённую до него, можно восстановить."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Restore previous configuration"
msgstr "Восстановить прежнюю конфигурацию"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Start setup"
msgstr "Начать настройку"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Restore"
msgstr "Восстановить"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Restoring the configuration saved before the unfinished Apply…"
msgstr "Восстановление конфигурации, сохранённой до незавершённого применения…"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The previous configuration was restored."
msgstr "Прежняя конфигурация восстановлена."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Restore failed"
msgstr "Восстановить не удалось"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Paste the vless:// link of your server. Your provider gives it to you (often as \"Copy link\" or as a QR code in the app)."
msgstr "Вставьте ссылку vless:// вашего сервера. Её выдаёт провайдер (часто как «Скопировать ссылку» или QR-код в приложении)."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Add server"
msgstr "Добавить сервер"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Paste a new VLESS link"
msgstr "Вставить новую VLESS-ссылку"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Use a server that is already in Node List"
msgstr "Использовать сервер, который уже есть в «Списке узлов»"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Added"
msgstr "Добавлен"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The server was added to Node List with these settings:"
msgstr "Сервер добавлен в «Список узлов» с такими настройками:"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Only VLESS is supported (TCP, WebSocket, gRPC, HTTPUpgrade; TLS or Reality). A subscription URL can be added later in Node List."
msgstr "Поддерживается только VLESS (TCP, WebSocket, gRPC, HTTPUpgrade; TLS или Reality). Ссылку на подписку можно добавить позже в «Списке узлов»."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Select a server."
msgstr "Выберите сервер."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Adding…"
msgstr "Добавление…"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The router did not answer: %s"
msgstr "Роутер не ответил: %s"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The link was not accepted by the VLESS parser."
msgstr "Разборщик VLESS не принял ссылку."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Easy VLESS now connects through the server with a temporary sing-box instance and opens two web addresses over HTTPS (a real request through the VLESS connection, not only a TCP connect)."
msgstr "Сейчас Easy VLESS подключится через сервер с помощью временного экземпляра sing-box и откроет два адреса по HTTPS (настоящий запрос через VLESS-соединение, а не только TCP-подключение)."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The server works."
msgstr "Сервер работает."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The server works, but %s did not answer through it. You can continue."
msgstr "Сервер работает, но %s через него не ответил. Можно продолжить."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The server did not work. Check the link (address, port, UUID, Reality key), that the server is online, and the router's internet connection."
msgstr "Сервер не работает. Проверьте ссылку (адрес, порт, UUID, ключ Reality), что сервер включён и что у роутера есть доступ в интернет."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "You can repeat the test, go back and paste another link, or continue anyway (Easy VLESS then starts, but the traffic through this server will not work)."
msgstr "Можно повторить проверку, вернуться и вставить другую ссылку или всё равно продолжить (Easy VLESS запустится, но трафик через этот сервер работать не будет)."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Repeat test"
msgstr "Повторить проверку"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Continue anyway"
msgstr "Всё равно продолжить"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Choose what goes through the server. Rules can be changed later in Rule Manage, their targets on Main."
msgstr "Выберите, что пойдёт через сервер. Правила можно изменить позже в «Правилах», их цели — на Главной."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Recommended: Russian sites direct, everything else through VLESS"
msgstr "Рекомендуется: российские сайты напрямую, остальное через VLESS"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Not available: the prepared rules could not be read (%s)."
msgstr "Недоступно: не удалось прочитать готовые правила (%s)."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "no rule templates"
msgstr "нет шаблонов правил"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Everything through VLESS"
msgstr "Всё через VLESS"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "All traffic of the router and of the LAN devices goes through %s."
msgstr "Весь трафик роутера и устройств LAN идёт через %s."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Keep the current routing"
msgstr "Оставить текущую маршрутизацию"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The routing is not changed; the server is only added to Node List. Current routing:"
msgstr "Маршрутизация не меняется; сервер только добавляется в «Список узлов». Текущая маршрутизация:"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "on"
msgstr "вкл."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "off"
msgstr "выкл"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Check the settings. Apply saves them, checks the configuration with sing-box and starts Easy VLESS."
msgstr "Проверьте настройки. «Применить» сохранит их, проверит конфигурацию в sing-box и запустит Easy VLESS."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Proxied domains"
msgstr "Проксируемые домены"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "%s through the server"
msgstr "%s через сервер"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Direct domains"
msgstr "Домены напрямую"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "the provider's DNS (automatic)"
msgstr "DNS провайдера (автоматически)"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "DNS of LAN devices"
msgstr "DNS устройств LAN"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "redirected to the router (dnsmasq → sing-box)"
msgstr "перенаправляется на роутер (dnsmasq → sing-box)"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "not redirected"
msgstr "не перенаправляется"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "LAN devices"
msgstr "Устройства LAN"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "transparent proxy (%s)"
msgstr "прозрачный прокси (%s)"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "not proxied"
msgstr "не проксируются"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The router itself"
msgstr "Сам роутер"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "proxied"
msgstr "проксируется"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Ports"
msgstr "Порты"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "DNS and forwarding keep their current values; change them later in Settings."
msgstr "DNS и перенаправление сохраняют текущие значения; их можно изменить позже в «Настройках»."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "What Apply does"
msgstr "Что делает «Применить»"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "the routing is not changed"
msgstr "маршрутизация не меняется"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "writes the routing above (Rule Manage / Main)"
msgstr "записывает маршрутизацию выше («Правила» / Главная)"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "checks the configuration with sing-box; nothing starts if it is invalid"
msgstr "проверяет конфигурацию в sing-box; при ошибке ничего не запускается"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "turns the main switch on: Easy VLESS starts now and on every boot"
msgstr "включает главный переключатель: Easy VLESS запускается сейчас и при каждой загрузке"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "starts sing-box, the firewall rules (nft table inet easy_vless) and the DNS forwarding"
msgstr "запускает sing-box, правила межсетевого экрана (таблица nft inet easy_vless) и перенаправление DNS"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "An earlier Apply of the wizard did not finish. Apply saves a new copy first; to go back to the configuration from before that earlier Apply, restore it now."
msgstr "Предыдущее применение мастера не завершилось. «Применить» сначала сохранит новую копию; чтобы вернуться к конфигурации, которая была до того применения, восстановите её сейчас."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Save a copy of the current configuration"
msgstr "Сохранить копию текущей конфигурации"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Save the configuration"
msgstr "Сохранить конфигурацию"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Check the configuration (sing-box check)"
msgstr "Проверить конфигурацию (sing-box check)"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Start Easy VLESS"
msgstr "Запустить Easy VLESS"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Check the service status"
msgstr "Проверить состояние службы"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Finish the setup"
msgstr "Завершить настройку"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The configuration from before Apply was restored; Easy VLESS was not left half-configured."
msgstr "Конфигурация, которая была до применения, восстановлена; Easy VLESS не остался настроенным наполовину."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Restoring the previous configuration failed: %s"
msgstr "Не удалось восстановить прежнюю конфигурацию: %s"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Go back to change the server or the routing, or try Apply again."
msgstr "Вернитесь, чтобы изменить сервер или маршрутизацию, или попробуйте применить ещё раз."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Try again"
msgstr "Повторить"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Apply failed: the current configuration could not be saved. Nothing was changed."
msgstr "Не удалось применить: не удалось сохранить текущую конфигурацию. Ничего не изменено."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The configuration is invalid: Easy VLESS was not started."
msgstr "Конфигурация неверна: Easy VLESS не запущен."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Easy VLESS did not start in time."
msgstr "Easy VLESS не запустился вовремя."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Easy VLESS did not start (the start was rolled back)."
msgstr "Easy VLESS не запустился (запуск отменён)."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Easy VLESS started, but its status is not complete (process: %s, firewall table: %s)."
msgstr "Easy VLESS запущен, но его состояние неполное (процесс: %s, таблица межсетевого экрана: %s)."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "running"
msgstr "работает"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Easy VLESS runs, but the setup could not be marked as finished."
msgstr "Easy VLESS работает, но не удалось отметить настройку как завершённую."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Apply failed: the configuration could not be saved."
msgstr "Не удалось применить: не удалось сохранить конфигурацию."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Apply failed: %s"
msgstr "Не удалось применить: %s"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgctxt "connection check result"
msgid "OK"
msgstr "ОК"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "no answer"
msgstr "нет ответа"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "%s did not answer (HTTP %s). Check the Server Test on Main."
msgstr "%s не ответил (HTTP %s). Проверьте сервер на Главной («Проверка соединения»)."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Easy VLESS is set up and running."
msgstr "Easy VLESS настроен и работает."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Russian sites direct, everything else through VLESS"
msgstr "Российские сайты напрямую, остальное через VLESS"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Service"
msgstr "Служба"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Connection"
msgstr "Соединение"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Main shows the status and the connection test, Node List manages servers and subscriptions, Rule Manage the rules."
msgstr "На Главной — состояние и проверка соединения, в «Списке узлов» — серверы и подписки, в «Правилах» — правила."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Open Main"
msgstr "Открыть Главную"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Open Node List"
msgstr "Открыть «Список узлов»"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Open Rule Manage"
msgstr "Открыть «Правила»"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Finish"
msgstr "Завершить"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Leave the setup?"
msgstr "Выйти из настройки?"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Nothing was applied: Easy VLESS and your settings stay as they are."
msgstr "Ничего не применено: Easy VLESS и ваши настройки остаются как были."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "The server \"%s\" added in this setup is removed again."
msgstr "Сервер «%s», добавленный в этой настройке, будет удалён."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "You can open the setup again at any time: Services → Easy VLESS → Setup Wizard."
msgstr "Мастер можно открыть снова в любой момент: Службы → Easy VLESS → Мастер настройки."

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Continue setup"
msgstr "Продолжить настройку"

#: luci/htdocs/luci-static/resources/view/easy_vless/wizard.js
msgid "Leave setup"
msgstr "Выйти из настройки"

