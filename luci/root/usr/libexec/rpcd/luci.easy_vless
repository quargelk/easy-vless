#!/bin/sh
# rpcd exec plugin for luci-app-easy-vless (ubus object "luci.easy_vless").
# Thin wrapper around the easy-vless runtime; all real work is done by
# /usr/share/easy_vless/app.sh, test.sh, subscribe.lua, clash_api.lua and
# /etc/init.d/easy_vless. Every method answers with JSON; failures carry a
# human readable reason ("output"/"error") so LuCI never fails silently.

. /usr/share/libubox/jshn.sh

CONFIG=easy_vless
APP=/usr/share/easy_vless/app.sh
INIT=/etc/init.d/easy_vless
LOG_FILE=/tmp/log/${CONFIG}.log
LINKS_FILE=/tmp/links.conf
CLASH_API=/usr/share/easy_vless/clash_api.lua
SUBSCRIBE=/usr/share/easy_vless/subscribe.lua
TEST=/usr/share/easy_vless/test.sh
DIAG=/usr/share/easy_vless/diag.lua
BACKUP=/usr/share/easy_vless/backup.lua
UPDATE=/usr/share/easy_vless/update.sh
# last result of every subscription update (subscribe.lua, tmpfs)
SUB_STATE_DIR=/var/run/${CONFIG}_sub
SERVER_TEST_URL=https://www.gstatic.com/generate_204

# Run a service action detached from rpcd, so a slow start/stop never hits
# the rpcd exec timeout; LuCI polls "status" (running/busy) meanwhile.
run_detached() {
	( "$@" ) </dev/null >/dev/null 2>&1 &
}

count_nodes() {
	uci -q show ${CONFIG} | grep -c "=nodes$"
}

log_lines() {
	[ -f "$LOG_FILE" ] && wc -l < "$LOG_FILE" || echo 0
}

log_tail() {
	local n="${1:-40}"
	[ -f "$LOG_FILE" ] && tail -n "$n" "$LOG_FILE"
}

# Log lines written after line number $1 (the log may have been truncated
# meanwhile; then everything is new).
log_since() {
	local from="$1" now
	now=$(log_lines)
	[ "$now" -ge "$from" ] 2>/dev/null || from=0
	[ -f "$LOG_FILE" ] && tail -n "$((now - from))" "$LOG_FILE"
}

# status [log_from]: runtime state; "log" = the last 40 log lines, or the
# lines written after line number log_from (start/stop result dialogs).
method_status() {
	local from="$1" st
	st=$($APP status 2>/dev/null)
	[ -n "$st" ] || st='{}'
	json_load "$st"
	json_add_boolean "subscribe_busy" "$(sub_busy && echo 1 || echo 0)"
	if [ -n "$from" ] && [ "$from" -gt 0 ] 2>/dev/null; then
		json_add_string "log" "$(log_since "$from" | tail -n 60)"
	else
		json_add_string "log" "$(log_tail 40)"
	fi
	json_add_int "log_lines" "$(log_lines)"
	json_dump
}

# check: generate the sing-box config and run "sing-box check" on it
# (app.sh check_config: no firewall/routing/service changes).
method_check() {
	local node="$1" out code
	[ -n "$node" ] || node=$(uci -q get ${CONFIG}.@global[0].node)
	out=$($APP check $node 2>&1)
	code=$?
	json_init
	json_add_int "code" "$code"
	json_add_boolean "ok" "$([ "$code" = 0 ] && echo 1 || echo 0)"
	json_add_string "node" "$node"
	json_add_string "output" "$out"
	json_dump
}

# start: check first; only a valid configuration enables the main switch and
# (re)starts the service. The restart itself runs detached; LuCI then polls
# "status" until the service is up (or rolled back, see app.sh start).
method_start() {
	local node out code
	node=$(uci -q get ${CONFIG}.@global[0].node)
	out=$($APP check 2>&1)
	code=$?
	json_init
	json_add_int "code" "$code"
	json_add_boolean "ok" "$([ "$code" = 0 ] && echo 1 || echo 0)"
	json_add_string "node" "$node"
	json_add_string "output" "$out"
	json_add_int "log_mark" "$(log_lines)"
	if [ "$code" = 0 ]; then
		uci -q set ${CONFIG}.@global[0].enabled='1'
		uci -q commit ${CONFIG}
		run_detached $INIT restart
	else
		# Save & Apply may have committed enabled=1 from the form: an invalid
		# configuration must not be started on the next boot either.
		uci -q set ${CONFIG}.@global[0].enabled='0'
		uci -q commit ${CONFIG}
	fi
	json_dump
}

method_stop() {
	uci -q set ${CONFIG}.@global[0].enabled='0'
	uci -q commit ${CONFIG}
	json_init
	json_add_int "code" 0
	json_add_boolean "ok" 1
	json_add_int "log_mark" "$(log_lines)"
	run_detached $INIT stop
	json_dump
}

# Server Test: PassWall2's test.sh starts a temporary sing-box SOCKS instance
# for the node (its real VLESS outbound) and fetches
# https://www.gstatic.com/generate_204 through it with curl (test.sh
# url_test_json: result, latency and the real error reason). The result is
# also stored as the server's last Server Test / URL Test result (see
# method_test).
method_urltest_node() {
	local node="$1" url="$2" out kind=server
	# Optional url (0.5.0, per-node URL Test): only plain http(s) URLs.
	if [ -n "$url" ] && ! printf '%s' "$url" | grep -Eq '^https?://[A-Za-z0-9._~:/?#@!$&()*+,;=%-]+$'; then
		json_init
		json_add_boolean "ok" 0
		json_add_string "error" "Invalid test URL."
		json_dump
		return
	fi
	[ -n "$url" ] && kind=url
	out=$($TEST url_test_json "$node" "$url")
	case "$out" in
		"{"*) ;;
		*) json_init; json_add_boolean "ok" 0; json_add_string "error" "The test did not return a result."; json_dump; return ;;
	esac
	echo "$out"
	[ "$(uci -q get ${CONFIG}.${node})" = "nodes" ] && $TEST test_store "$node" "$kind" "$out"
}

# test <action> [kind] [nodes] (0.8.0): the Server Test / URL Test queue of
# test.sh - LuCI queues tests and polls "state"; a test of a server that is
# already queued or running is not started twice, and tests run one after
# another (never one sing-box instance per server at once).
#   state             queue, running test, progress, last result per server
#   add kind nodes    queue tests (kind server|url, nodes: ids separated by spaces)
#   cancel            drop the queued tests (the running one finishes)
#   clear nodes       forget the stored results of these servers (edited)
method_test() {
	local action="$1" kind="$2" nodes="$3"
	case "$action" in
		state) $TEST queue_state ;;
		add) (set -f; $TEST queue_add "$kind" $nodes) ;;
		cancel) $TEST queue_cancel ;;
		clear) (set -f; $TEST result_clear $nodes) ;;
		*) json_init; json_add_boolean "ok" 0; json_add_string "error" "Unknown action."; json_dump ;;
	esac
}

method_groups() {
	if [ ! -f "$CLASH_API" ]; then
		echo '{"ok":false,"error":"easy-vless-sing-box is not installed."}'
		return
	fi
	lua "$CLASH_API" groups
}

method_group_test() {
	local group="$1" url
	if [ ! -f "$CLASH_API" ]; then
		echo '{"ok":false,"error":"easy-vless-sing-box is not installed."}'
		return
	fi
	url=$(uci -q get ${CONFIG}.${group}.urltest_url)
	lua "$CLASH_API" test "$group" "$url"
}

# Prepared resources (0.5.0): manifest + installed file state + entry
# counts, computed by api.lua (easy-vless core).
method_resources() {
	local out
	out=$(lua -e "local api = require 'luci.easy_vless.api' io.write(api.resources_json())" 2>&1)
	case "$out" in
		"{"*) echo "$out" ;;
		*) json_init; json_add_boolean "ok" 0; json_add_string "error" "Cannot read resources: $out"; json_dump ;;
	esac
}

node_ids() {
	uci -q show ${CONFIG} | sed -n "s/^${CONFIG}\.\([^.=]*\)=nodes$/\1/p"
}

# ---------- First Run Wizard (0.6.0) ----------
# The wizard itself is LuCI (view/easy_vless/wizard.js): it imports the server
# with "import", tests it with "urltest_node", writes the routing with the
# Rule Manage templates, checks and starts with "check"/"start". These two
# methods only add what LuCI cannot do safely on its own: the first-run
# decision, and a backup of the committed configuration so a failed Apply
# never leaves a half-applied configuration behind.
WIZARD_BACKUP=/etc/easy_vless/wizard-backup

count_type() {
	uci -q show ${CONFIG} | grep -c "=$1$"
}

# wizard_state: needed = the wizard was never completed, the main switch is
# off and no existing node is selected (a manually configured router - main
# switch on or a node selected - never gets the wizard automatically).
method_wizard_state() {
	local completed enabled node node_ok=0 needed=0
	completed=$(uci -q get ${CONFIG}.@global[0].wizard_completed)
	enabled=$(uci -q get ${CONFIG}.@global[0].enabled)
	node=$(uci -q get ${CONFIG}.@global[0].node)
	[ -n "$node" ] && [ "$(uci -q get ${CONFIG}.${node})" = "nodes" ] && node_ok=1
	[ "$completed" != "1" ] && [ "$enabled" != "1" ] && [ "$node_ok" = 0 ] && needed=1
	json_init
	json_add_boolean "needed" "$needed"
	json_add_boolean "completed" "$([ "$completed" = 1 ] && echo 1 || echo 0)"
	json_add_boolean "enabled" "$([ "$enabled" = 1 ] && echo 1 || echo 0)"
	json_add_string "node" "$node"
	json_add_boolean "node_ok" "$node_ok"
	json_add_int "servers" "$(uci -q show ${CONFIG} | grep -c "\.protocol='vless'$")"
	json_add_int "rules" "$(count_type shunt_rules)"
	json_add_int "subscriptions" "$(count_type subscribe_list)"
	json_add_boolean "backup" "$([ -s "$WIZARD_BACKUP" ] && echo 1 || echo 0)"
	json_dump
}

# wizard <action>:
#   backup        copy the committed configuration (before Apply writes it)
#   restore       put that copy back (Apply failed or was abandoned) and bring
#                 the service to the restored state: stopped when its main
#                 switch is off, restarted with the old configuration when on
#   finish        Apply succeeded: wizard_completed=1, drop the copy
#   connectivity  HTTPS request from the router itself (through Easy VLESS
#                 while it runs with Localhost Proxy): the Done page status
method_wizard() {
	local action="$1" code
	json_init
	case "$action" in
		backup)
			mkdir -p "${WIZARD_BACKUP%/*}"
			if uci -q show ${CONFIG} >/dev/null && cp -f /etc/config/${CONFIG} "${WIZARD_BACKUP}.tmp" && mv -f "${WIZARD_BACKUP}.tmp" "$WIZARD_BACKUP"; then
				json_add_boolean "ok" 1
			else
				rm -f "${WIZARD_BACKUP}.tmp"
				json_add_boolean "ok" 0
				json_add_string "error" "Cannot save a copy of /etc/config/${CONFIG} to ${WIZARD_BACKUP}."
			fi
		;;
		restore)
			if [ ! -s "$WIZARD_BACKUP" ]; then
				json_add_boolean "ok" 0
				json_add_string "error" "No saved configuration to restore (${WIZARD_BACKUP} is missing)."
				json_dump
				return
			fi
			uci -q revert ${CONFIG}
			if ! cp -f "$WIZARD_BACKUP" /etc/config/${CONFIG}; then
				json_add_boolean "ok" 0
				json_add_string "error" "Cannot restore /etc/config/${CONFIG} from ${WIZARD_BACKUP}."
				json_dump
				return
			fi
			rm -f "$WIZARD_BACKUP"
			json_add_boolean "ok" 1
			json_add_int "log_mark" "$(log_lines)"
			if [ "$(uci -q get ${CONFIG}.@global[0].enabled)" = "1" ]; then
				json_add_string "service" "restart"
				run_detached $INIT restart
			else
				json_add_string "service" "stop"
				run_detached $INIT stop
			fi
		;;
		finish)
			uci -q set ${CONFIG}.@global[0].wizard_completed='1'
			if uci -q commit ${CONFIG}; then
				rm -f "$WIZARD_BACKUP"
				json_add_boolean "ok" 1
			else
				json_add_boolean "ok" 0
				json_add_string "error" "uci commit ${CONFIG} failed."
			fi
		;;
		connectivity)
			# certificate verified (no -k); 204 = the probe endpoint answered
			code=$(curl -s -o /dev/null --connect-timeout 5 --max-time 10 -w '%{http_code}' "$SERVER_TEST_URL" 2>/dev/null)
			json_add_boolean "ok" "$(case "$code" in 200|204) echo 1 ;; *) echo 0 ;; esac)"
			json_add_string "http_code" "$code"
			json_add_string "url" "$SERVER_TEST_URL"
		;;
		*)
			json_add_boolean "ok" 0
			json_add_string "error" "Unknown action."
		;;
	esac
	json_dump
}

# Import one or more vless:// links through the existing subscribe.lua parser.
method_import() {
	local links="$1" before after out code mark found newlog skipped
	json_init
	case "$links" in
		*vless://*) ;;
		*)
			json_add_int "code" 1
			json_add_int "found" 0
			json_add_int "added" 0
			json_add_string "output" "No vless:// link found."
			json_dump
			return
		;;
	esac
	# the import changes the node list like an update does (subscribe.lua
	# would leave without a word while its lock is taken): say why
	if sub_busy; then
		json_add_int "code" 1
		json_add_int "found" 0
		json_add_int "added" 0
		json_add_string "output" "A subscription update is running; try again when it has finished."
		json_dump
		return
	fi
	found=$(printf '%s\n' "$links" | grep -c '://')
	before=$(count_nodes)
	local ids_before=$(node_ids)
	mark=$(log_lines)
	printf '%s\n' "$links" > "$LINKS_FILE"
	# subscribe.lua reads $LINKS_FILE and deletes it; an empty group name keeps
	# manually imported nodes ungrouped (add_mode=1).
	out=$(lua $SUBSCRIBE add "" 2>&1)
	code=$?
	rm -f "$LINKS_FILE"
	after=$(count_nodes)
	newlog=$(log_since "$mark")
	skipped=$((found - (after - before)))
	[ "$skipped" -ge 0 ] || skipped=0
	json_add_int "code" "$code"
	json_add_int "found" "$found"
	json_add_int "added" "$((after - before))"
	json_add_int "skipped" "$skipped"
	json_add_string "output" "$out"
	json_add_string "log" "$newlog"
	# Parsed result of every new node, so LuCI can show what was imported.
	local id
	json_add_array "nodes"
	for id in $(node_ids); do
		case " $(echo $ids_before) " in *" $id "*) continue ;; esac
		json_add_object ""
		json_add_string "id" "$id"
		json_add_string "remarks" "$(uci -q get ${CONFIG}.${id}.remarks)"
		json_add_string "address" "$(uci -q get ${CONFIG}.${id}.address)"
		json_add_string "port" "$(uci -q get ${CONFIG}.${id}.port)"
		json_add_string "transport" "$(uci -q get ${CONFIG}.${id}.transport)"
		json_add_string "tls" "$(uci -q get ${CONFIG}.${id}.tls)"
		json_add_string "reality" "$(uci -q get ${CONFIG}.${id}.reality)"
		json_add_string "flow" "$(uci -q get ${CONFIG}.${id}.flow)"
		json_add_string "sni" "$(uci -q get ${CONFIG}.${id}.tls_serverName)"
		json_close_object
	done
	json_close_array
	json_dump
}

# An update runs: subscribe.lua holds its lock, or has just been started and
# not taken it yet (it takes it after loading and a short random delay).
# The lock holds the PID of its owner (1.0): one left behind by a process
# that is gone (killed, ended with an error) is removed here instead of
# answering "busy" until the next reboot.
sub_busy() {
	local lock=/var/lock/${CONFIG}_subscribe.lock pid
	if [ -f "$lock" ]; then
		pid=$(cat "$lock" 2>/dev/null)
		case "$pid" in
			""|*[!0-9]*) return 0 ;;
		esac
		[ -d "/proc/$pid" ] && return 0
		rm -f "$lock"
	fi
	busybox pgrep -f "subscribe\.lua start" >/dev/null 2>&1
}

# Subscriptions (config subscribe_list): "update" downloads and parses the
# subscription(s) with subscribe.lua (detached, may take long; LuCI polls
# status.subscribe_busy), "truncate" deletes the nodes of one subscription.
method_subscribe() {
	local action="$1" id="$2" remark
	json_init
	if [ -n "$id" ] && ! valid_id "$id"; then
		json_add_int "code" 1
		json_add_string "output" "Unknown subscription."
		json_dump
		return
	fi
	case "$action" in
		update)
			[ -n "$id" ] || id=all
			if [ "$id" != "all" ] && [ "$(uci -q get ${CONFIG}.${id})" != "subscribe_list" ]; then
				json_add_int "code" 1
				json_add_string "output" "Unknown subscription."
				json_dump
				return
			fi
			if sub_busy; then
				json_add_int "code" 1
				json_add_string "output" "A subscription update is already running."
				json_dump
				return
			fi
			json_add_int "code" 0
			json_add_int "log_mark" "$(log_lines)"
			json_add_int "nodes" "$(count_nodes)"
			json_add_int "started" "$(date +%s)"
			mkdir -p "$SUB_STATE_DIR"
			echo "$id" > "$SUB_STATE_DIR/updating"
			run_detached lua $SUBSCRIBE start "$id" manual
		;;
		state)
			local busy=0
			sub_busy && busy=1
			json_add_int "code" 0
			json_add_boolean "busy" "$busy"
			json_add_int "now" "$(date +%s)"
			[ "$busy" = 1 ] && json_add_string "updating" "$(cat "$SUB_STATE_DIR/updating" 2>/dev/null)"
			json_add_object "results"
			local f
			for f in "$SUB_STATE_DIR"/*.json; do
				[ -s "$f" ] || continue
				f=${f##*/}; f=${f%.json}
				if [ "$(uci -q get ${CONFIG}.${f})" = "subscribe_list" ]; then
					json_add_string "$f" "$(cat "$SUB_STATE_DIR/$f.json")"
				else
					rm -f "$SUB_STATE_DIR/$f.json"
				fi
			done
			json_close_object
		;;
		truncate)
			remark=$(uci -q get ${CONFIG}.${id}.remark)
			if [ "$(uci -q get ${CONFIG}.${id})" != "subscribe_list" ] || [ -z "$remark" ]; then
				json_add_int "code" 1
				json_add_string "output" "Unknown subscription."
				json_dump
				return
			fi
			# never race a running (detached) update: both rewrite the node list
			if sub_busy; then
				json_add_int "code" 1
				json_add_string "output" "A subscription update is running; try again when it has finished."
				json_dump
				return
			fi
			local before=$(count_nodes)
			lua $SUBSCRIBE truncate "$remark" >/dev/null 2>&1
			json_add_int "code" 0
			json_add_int "removed" "$((before - $(count_nodes)))"
		;;
		*)
			json_add_int "code" 2
			json_add_string "output" "Unknown action."
		;;
	esac
	json_dump
}

# nodes <action> [id] [key] (0.9.0): node list actions that must not race a
# subscription update and must leave no broken reference behind. The work is
# done by subscribe.lua (it owns the node list and its lock) with nodes.lua.
#   delete id          delete one server (refused while it is still used); a
#                      subscription node is not imported again by updates
#   delete_all_plan    what "Delete all nodes" would do (changes nothing)
#   delete_all         delete every server and repair what pointed to them;
#                      then the service is stopped (no main node left) or
#                      restarted (it was running with one of the servers)
#   restore id [key]   subscription id: forget one / all of its deleted nodes
method_nodes() {
	local action="$1" id="$2" key="$3" out ok stop service=none running ids
	json_init
	case "$action" in
		delete|delete_all|delete_all_plan|restore) ;;
		*)
			json_add_boolean "ok" 0
			json_add_string "error" "action"
			json_dump
			return
		;;
	esac
	case "${id}${key}" in
		*[!A-Za-z0-9_]*)
			json_add_boolean "ok" 0
			json_add_string "error" "unknown"
			json_dump
			return
		;;
	esac
	# never race a running (detached) update: both rewrite the node list
	if sub_busy; then
		json_add_boolean "ok" 0
		json_add_string "error" "busy"
		json_dump
		return
	fi
	# queued Server Tests of servers that are about to disappear
	[ "$action" = "delete_all" ] && $TEST queue_cancel >/dev/null 2>&1
	out=$(lua $SUBSCRIBE "$action" "$id" "$key" 2>/dev/null)
	case "$out" in
		"{"*) ;;
		*)
			json_add_boolean "ok" 0
			json_add_string "error" "busy"
			json_dump
			return
		;;
	esac
	json_load "$out"
	json_get_var ok ok
	if [ "$ok" = 1 ] && [ "$action" = "delete" ]; then
		$TEST result_clear "$id" >/dev/null 2>&1
	fi
	if [ "$ok" = 1 ] && [ "$action" = "delete_all" ]; then
		ids=$(jsonfilter -s "$out" -e '@.removed[*]' 2>/dev/null)
		[ -n "$ids" ] && (set -f; $TEST result_clear $ids) >/dev/null 2>&1
		json_get_var stop stop
		running=$(jsonfilter -s "$($APP status 2>/dev/null)" -e '@.running' 2>/dev/null)
		json_add_int "log_mark" "$(log_lines)"
		if [ "$stop" = 1 ]; then
			service=stop
			run_detached $INIT stop
		elif [ "$running" = "true" ] && [ -n "$ids" ]; then
			service=restart
			run_detached $INIT restart
		fi
		json_add_string "service" "$service"
	fi
	json_dump
}

# diag <action> [arg] (0.9.0): Route Explain and diagnostics - read-only
# (diag.lua with explain.lua / diagnose.lua). Nothing is started, stopped or
# saved; a consistent copy of the sing-box configuration is taken by
# "app.sh diag_config" under the operation lock (short wait, then "busy").
#   explain '<json>'   where a connection goes and why: input (domain, IP,
#                      host:port, URL), network, port, protocol, source
#   dns <domain>       DNS diagnostics of one domain
#   forwarding         nftables / TPROXY / policy routing diagnostics
#   connection         the single panel (Core, DNS, nftables, TPROXY, VLESS,
#                      Routing, Internet) built from the checks above
method_diag() {
	local action="$1" arg="$2" out
	case "$action" in
		explain|dns|forwarding|connection) ;;
		*)
			echo '{"ok":false,"error":"action"}'
			return
		;;
	esac
	if [ ! -f "$DIAG" ]; then
		echo '{"ok":false,"error":"not_installed"}'
		return
	fi
	out=$(lua "$DIAG" "$action" "$arg" 2>/dev/null)
	case "$out" in
		"{"*) echo "$out" ;;
		*) echo '{"ok":false,"error":"interrupted"}' ;;
	esac
}

# transfer (0.9.0): Backup / Restore and Import / Export (backup.lua with
# transfer.lua). The request { action, data, kind } is handed to backup.lua
# as it came (a backup can be large; it never passes through shell words).
#   backup, restore_check, restore_apply, rollback, state,
#   export, import_check, import_apply
# A file is validated completely before the configuration is changed. After
# a restore / rollback the service is brought to the restored state: stopped
# when its main switch is off, restarted with the restored configuration
# when on (detached; LuCI polls "status").
method_transfer() {
	local input="$1" out service
	if [ ! -f "$BACKUP" ]; then
		echo '{"ok":false,"error":{"code":"not_installed"}}'
		return
	fi
	out=$(printf '%s' "$input" | lua "$BACKUP" 2>/dev/null)
	case "$out" in
		"{"*) ;;
		*)
			echo '{"ok":false,"error":{"code":"interrupted"}}'
			return
		;;
	esac
	service=$(jsonfilter -s "$out" -e '@.service' 2>/dev/null)
	case "$service" in
		restart) run_detached $INIT restart ;;
		stop) run_detached $INIT stop ;;
	esac
	echo "$out"
}

# update <action> [tag] (0.9.0): update from a GitHub release (update.sh).
#   check           is a newer release available (answer cached for a day)
#   recheck         the same, asking GitHub now
#   state           progress / result of the last installation, last check
#   install tag     download, verify, check compatibility, save the
#                   configuration, install, validate, restart - or roll back.
#                   Only ever started from here, by an explicit click in
#                   LuCI; it runs detached (the package upgrade restarts
#                   rpcd) and LuCI polls "state".
method_update() {
	local action="$1" tag="$2" out
	if [ ! -f "$UPDATE" ]; then
		echo '{"ok":false,"error":"not_installed"}'
		return
	fi
	case "$action" in
		check) out=$(sh "$UPDATE" check 2>/dev/null) ;;
		recheck) out=$(sh "$UPDATE" check force 2>/dev/null) ;;
		state) out=$(sh "$UPDATE" state 2>/dev/null) ;;
		install)
			case "$tag" in
				""|*[!A-Za-z0-9.-]*)
					echo '{"ok":false,"error":"tag"}'
					return
				;;
			esac
			if [ -d "/var/lock/${CONFIG}_update.lock" ]; then
				echo '{"ok":false,"error":"busy"}'
				return
			fi
			# its own session: the rpcd restart of the package upgrade must not end it
			if command -v setsid >/dev/null 2>&1; then
				( setsid sh "$UPDATE" install "$tag" ) </dev/null >/dev/null 2>&1 &
			else
				( sh "$UPDATE" install "$tag" ) </dev/null >/dev/null 2>&1 &
			fi
			echo '{"ok":true,"started":true}'
			return
		;;
		*)
			echo '{"ok":false,"error":"action"}'
			return
		;;
	esac
	case "$out" in
		"{"*) echo "$out" ;;
		*) echo '{"ok":false,"error":"interrupted"}' ;;
	esac
}

case "$1" in
	list)
		json_init
		json_add_object "status"; json_add_int "log_from" 0; json_close_object
		json_add_object "check"; json_add_string "node" "string"; json_close_object
		json_add_object "start"; json_close_object
		json_add_object "stop"; json_close_object
		json_add_object "import"; json_add_string "links" "string"; json_close_object
		json_add_object "subscribe"; json_add_string "action" "string"; json_add_string "id" "string"; json_close_object
		json_add_object "urltest_node"; json_add_string "node" "string"; json_add_string "url" "string"; json_close_object
		json_add_object "test"; json_add_string "action" "string"; json_add_string "kind" "string"; json_add_string "nodes" "string"; json_close_object
		json_add_object "resources"; json_close_object
		json_add_object "groups"; json_close_object
		json_add_object "group_test"; json_add_string "group" "string"; json_close_object
		json_add_object "wizard_state"; json_close_object
		json_add_object "wizard"; json_add_string "action" "string"; json_close_object
		json_add_object "nodes"; json_add_string "action" "string"; json_add_string "id" "string"; json_add_string "key" "string"; json_close_object
		json_add_object "diag"; json_add_string "action" "string"; json_add_string "arg" "string"; json_close_object
		json_add_object "transfer"; json_add_string "action" "string"; json_add_string "data" "string"; json_add_string "kind" "string"; json_close_object
		json_add_object "update"; json_add_string "action" "string"; json_add_string "tag" "string"; json_close_object
		json_dump
	;;
	call)
		input=$(cat)
		[ -n "$input" ] || input='{}'
		case "$2" in
			status)
				json_load "$input"; json_get_var log_from log_from
				method_status "$log_from"
			;;
			check)
				json_load "$input"; json_get_var node node
				method_check "$node"
			;;
			start) method_start ;;
			stop) method_stop ;;
			import)
				json_load "$input"; json_get_var links links
				method_import "$links"
			;;
			subscribe)
				json_load "$input"; json_get_var action action; json_get_var id id
				method_subscribe "$action" "$id"
			;;
			urltest_node)
				json_load "$input"; json_get_var node node; json_get_var url url
				method_urltest_node "$node" "$url"
			;;
			test)
				json_load "$input"; json_get_var action action; json_get_var kind kind; json_get_var nodes nodes
				method_test "$action" "$kind" "$nodes"
			;;
			resources) method_resources ;;
			groups) method_groups ;;
			group_test)
				json_load "$input"; json_get_var group group
				method_group_test "$group"
			;;
			wizard_state) method_wizard_state ;;
			wizard)
				json_load "$input"; json_get_var action action
				method_wizard "$action"
			;;
			nodes)
				json_load "$input"; json_get_var action action; json_get_var id id; json_get_var key key
				method_nodes "$action" "$id" "$key"
			;;
			diag)
				json_load "$input"; json_get_var action action; json_get_var arg arg
				method_diag "$action" "$arg"
			;;
			transfer) method_transfer "$input" ;;
			update)
				json_load "$input"; json_get_var action action; json_get_var tag tag
				method_update "$action" "$tag"
			;;
			*)
				json_init; json_add_int "code" 2; json_add_string "output" "Unknown method"; json_dump
			;;
		esac
	;;
esac
